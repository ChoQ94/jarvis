# 이 파일을 복사해서 .dev.vars 로 만들고 실제 값을 채우세요.
#   cp .dev.vars.example .dev.vars
#
# .dev.vars 는 .gitignore 에 있어 깃에 올라가지 않습니다. 절대 커밋하지 마세요.
# 배포된 Worker 는 이 파일이 아니라 `wrangler secret put` 으로 올린 값을 씁니다.
# (Cloudflare 에 올린 시크릿은 다시 꺼내볼 수 없으므로, 이 파일을 백업 삼아 두는 게 좋습니다)


# ── 필수 ────────────────────────────────────────────────────────────

# 리마인더 봇 토큰.
# 텔레그램에서 @BotFather → /newbot → 이름 지정 → 토큰 발급
# 알람 발송과 모든 명령어(/add, /list ...) 처리를 담당합니다.
TELEGRAM_BOT_TOKEN="123456789:AA-여기에-토큰"

# 텔레그램 웹훅 검증용 공유 비밀. 아무 랜덤 문자열이면 됩니다.
#   openssl rand -hex 32
# 영문·숫자·_·- 만 사용 가능 (1~256자). 텔레그램이 요청마다 이 값을
# X-Telegram-Bot-Api-Secret-Token 헤더에 실어 보내고, Worker 가 대조합니다.
TELEGRAM_WEBHOOK_SECRET="랜덤한-64자-hex-문자열"

# 봇을 사용할 수 있는 텔레그램 chat_id (콤마로 여러 개 가능).
# 봇에게 /id 를 보내면 값을 알려줍니다. 비워두면 누구나 봇을 쓸 수 있습니다.
ALLOWED_CHAT_IDS="123456789"


# ── 선택 ────────────────────────────────────────────────────────────

# 웹 채팅 UI 로그인 비밀번호.
# 설정하지 않으면 웹 UI 가 비활성화됩니다 (텔레그램·CLI 는 그대로 동작).
WEB_PASSWORD="원하는-비밀번호"

# 새 AI 모델 알림을 받을 전용 봇 토큰.
# 리마인더와 모델 소식이 한 채팅에 섞이지 않게 분리하는 용도입니다.
# @BotFather 에서 봇을 하나 더 만들어 토큰을 넣으세요.
#
# ⚠️ 만든 뒤 그 봇에게 아무 메시지나 한 번 보내야 합니다.
#    텔레그램은 사용자가 먼저 말을 걸어야 봇의 발송을 허용합니다.
#
# 설정하지 않으면 모델 알림도 리마인더 봇으로 갑니다.
# chat_id 는 봇이 달라도 같으므로 따로 설정할 필요가 없습니다.
WATCHER_BOT_TOKEN="987654321:BB-여기에-두번째-봇-토큰"
